# Simpan nilai aktual hanya di Windows lokal; jangan commit .env yang berisi secret.
AERO_TRADE_BRIDGE_TOKEN=ganti-dengan-secret-acak-minimal-24-karakter
AERO_TRADE_BRIDGE_URL=http://127.0.0.1:8765
# Tetap kosong secara default. Set menjadi YES hanya saat akan mengeksekusi proposal akun demo yang telah ditinjau.
AERO_TRADE_DEMO_EXECUTION_ENABLED=
